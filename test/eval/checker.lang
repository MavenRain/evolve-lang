-- One backfill batch: the keys 1 to 100 (Q-S6-12 (a)).
batchOne : KeyRange
batchOne = pack 1 100

batchOneHi : ℕ
batchOneHi = payload batchOne

-- A negative case: setNotNull at base_1 has no valid CHECK, so it scans
-- under ACCESS EXCLUSIVE, and `lockSafe` gives false.
chainSetNotNullNoCheck : Chain 3 1 base_1 (postSetNotNull 3 1 base_1 usersTbl users_display_name)
chainSetNotNullNoCheck = snoc 3 1 base_1 base_1 (postSetNotNull 3 1 base_1 usersTbl users_display_name) (nil 3 1 base_1) (setNotNull 3 1 base_1 usersTbl users_display_name refl)

lockSafeSetNotNullNoCheck : Bool
lockSafeSetNotNullNoCheck = lockSafe 3 1 base_1 (postSetNotNull 3 1 base_1 usersTbl users_display_name) chainSetNotNullNoCheck
