-- The checker types (S4 U0): the lock and the scan class of each step form
-- (PLAN 5.1, Q-S4-6 (a)) and the link field (Q-S4-3 (a)). Each step term is
-- written here on a stage of the protocol `base`, or on a state after it.
table users (name : text, id : bigint key)

app v0 (reads users.id)

protocol base where
  addColumn users display_name text

usersTbl : Fin 1
usersTbl = pack 0 refl

synced : State 3 1
synced = postInstallSync 3 1 base_1 usersTbl users_name users_display_name

unsynced : State 3 1
unsynced = postDropSync 3 1 synced usersTbl users_name users_display_name

copied : State 3 1
copied = postBackfill 3 1 base_1 usersTbl users_display_name users_name 1000

guarded : State 3 1
guarded = postAddNotNullCheck 3 1 base_1 usersTbl users_display_name

checked : State 3 1
checked = postValidate 3 1 guarded usersTbl users_display_name

lockAddColumn : LockMode
lockAddColumn = lockOf 3 1 base_0 base_1 (addColumn 3 1 base_0 usersTbl users_display_name text refl)

lockInstallSync : LockMode
lockInstallSync = lockOf 3 1 base_1 synced (installSync 3 1 base_1 usersTbl users_name users_display_name refl)

lockDropSync : LockMode
lockDropSync = lockOf 3 1 synced unsynced (dropSync 3 1 synced usersTbl users_name users_display_name refl)

lockBackfill : LockMode
lockBackfill = lockOf 3 1 base_1 copied (backfill 3 1 base_1 usersTbl users_display_name users_name 1000 refl)

lockDeploy : LockMode
lockDeploy = lockOf 3 1 base_1 base_1 (deploy 3 1 base_1 v0)

lockRetire : LockMode
lockRetire = lockOf 3 1 base_1 base_1 (retire 3 1 base_1 v0)

lockDropColumn : LockMode
lockDropColumn = lockOf 3 1 base_1 (postDropColumn 3 1 base_1 usersTbl users_name) (dropColumn 3 1 base_1 usersTbl users_name refl)

lockAddNotNullCheck : LockMode
lockAddNotNullCheck = lockOf 3 1 base_1 guarded (addNotNullCheck 3 1 base_1 usersTbl users_display_name refl)

lockValidate : LockMode
lockValidate = lockOf 3 1 guarded checked (validate 3 1 guarded usersTbl users_display_name refl)

lockSetNotNull : LockMode
lockSetNotNull = lockOf 3 1 checked (postSetNotNull 3 1 checked usersTbl users_display_name) (setNotNull 3 1 checked usersTbl users_display_name refl)

lockDropCheck : LockMode
lockDropCheck = lockOf 3 1 guarded (postDropCheck 3 1 guarded usersTbl users_display_name) (dropCheck 3 1 guarded usersTbl users_display_name refl)

lockCreateIndex : LockMode
lockCreateIndex = lockOf 3 1 guarded guarded (createIndexConcurrently 3 1 guarded usersTbl users_display_name refl)

scanAddColumn : ScanClass
scanAddColumn = scanOf 3 1 base_0 base_1 (addColumn 3 1 base_0 usersTbl users_display_name text refl)

scanInstallSync : ScanClass
scanInstallSync = scanOf 3 1 base_1 synced (installSync 3 1 base_1 usersTbl users_name users_display_name refl)

scanDropSync : ScanClass
scanDropSync = scanOf 3 1 synced unsynced (dropSync 3 1 synced usersTbl users_name users_display_name refl)

scanBackfill : ScanClass
scanBackfill = scanOf 3 1 base_1 copied (backfill 3 1 base_1 usersTbl users_display_name users_name 1000 refl)

scanDeploy : ScanClass
scanDeploy = scanOf 3 1 base_1 base_1 (deploy 3 1 base_1 v0)

scanRetire : ScanClass
scanRetire = scanOf 3 1 base_1 base_1 (retire 3 1 base_1 v0)

scanDropColumn : ScanClass
scanDropColumn = scanOf 3 1 base_1 (postDropColumn 3 1 base_1 usersTbl users_name) (dropColumn 3 1 base_1 usersTbl users_name refl)

scanAddNotNullCheck : ScanClass
scanAddNotNullCheck = scanOf 3 1 base_1 guarded (addNotNullCheck 3 1 base_1 usersTbl users_display_name refl)

scanValidate : ScanClass
scanValidate = scanOf 3 1 guarded checked (validate 3 1 guarded usersTbl users_display_name refl)

scanSetNotNull : ScanClass
scanSetNotNull = scanOf 3 1 checked (postSetNotNull 3 1 checked usersTbl users_display_name) (setNotNull 3 1 checked usersTbl users_display_name refl)

scanSetNotNullNoCheck : ScanClass
scanSetNotNullNoCheck = scanOf 3 1 base_1 (postSetNotNull 3 1 base_1 usersTbl users_display_name) (setNotNull 3 1 base_1 usersTbl users_display_name refl)

scanSetNotNullNotValid : ScanClass
scanSetNotNullNotValid = scanOf 3 1 guarded (postSetNotNull 3 1 guarded usersTbl users_display_name) (setNotNull 3 1 guarded usersTbl users_display_name refl)

scanDropCheck : ScanClass
scanDropCheck = scanOf 3 1 guarded (postDropCheck 3 1 guarded usersTbl users_display_name) (dropCheck 3 1 guarded usersTbl users_display_name refl)

scanCreateIndex : ScanClass
scanCreateIndex = scanOf 3 1 guarded guarded (createIndexConcurrently 3 1 guarded usersTbl users_display_name refl)

linkAtStart : Bool
linkAtStart = link 3 1 base_1 (witness users_name) (witness users_display_name)

linkAfterInstallSync : Bool
linkAfterInstallSync = link 3 1 synced (witness users_name) (witness users_display_name)

linkAfterInstallSyncBack : Bool
linkAfterInstallSyncBack = link 3 1 synced (witness users_display_name) (witness users_name)

linkAfterDropSync : Bool
linkAfterDropSync = link 3 1 unsynced (witness users_name) (witness users_display_name)

linkAfterBackfill : Bool
linkAfterBackfill = link 3 1 copied (witness users_display_name) (witness users_name)

linkAfterBackfillBack : Bool
linkAfterBackfillBack = link 3 1 copied (witness users_name) (witness users_display_name)

syncAfterBackfill : Bool
syncAfterBackfill = sync 3 1 copied (witness users_display_name) (witness users_name)

-- The laws L1, L4 and L6 on each step form (Q-S4-7 (a)). Each chain is one
-- step, on the stage of the step term above. v0 is live at each stage, and
-- `programCols` is all the program columns, in the code order. `accepts`
-- (L1), `dropSafe` (L4) and `lockSafe` (L6) give true on each chain, and a
-- `refl` proof shows it.
liveV0 : ℕ → Live 3
liveV0 i = pack 1 (λ (j : ℕ) → v0)

programCols : Cols 3
programCols = pack 3 (λ (j : ℕ) → flagIf (natEq j 0) users_name (flagIf (natEq j 1) users_id users_display_name))

chainAddColumn : Chain 3 1 base_0 base_1
chainAddColumn = snoc 3 1 base_0 base_0 base_1 (nil 3 1 base_0) (addColumn 3 1 base_0 usersTbl users_display_name text refl)

acceptsAddColumn : Bool
acceptsAddColumn = accepts 3 1 base_0 base_1 chainAddColumn liveV0 programCols

acceptsAddColumnProof : Path Bool acceptsAddColumn true
acceptsAddColumnProof = refl

dropSafeAddColumn : Bool
dropSafeAddColumn = dropSafe 3 1 base_0 base_1 chainAddColumn liveV0

dropSafeAddColumnProof : Path Bool dropSafeAddColumn true
dropSafeAddColumnProof = refl

lockSafeAddColumn : Bool
lockSafeAddColumn = lockSafe 3 1 base_0 base_1 chainAddColumn

lockSafeAddColumnProof : Path Bool lockSafeAddColumn true
lockSafeAddColumnProof = refl

chainInstallSync : Chain 3 1 base_1 synced
chainInstallSync = snoc 3 1 base_1 base_1 synced (nil 3 1 base_1) (installSync 3 1 base_1 usersTbl users_name users_display_name refl)

acceptsInstallSync : Bool
acceptsInstallSync = accepts 3 1 base_1 synced chainInstallSync liveV0 programCols

acceptsInstallSyncProof : Path Bool acceptsInstallSync true
acceptsInstallSyncProof = refl

dropSafeInstallSync : Bool
dropSafeInstallSync = dropSafe 3 1 base_1 synced chainInstallSync liveV0

dropSafeInstallSyncProof : Path Bool dropSafeInstallSync true
dropSafeInstallSyncProof = refl

lockSafeInstallSync : Bool
lockSafeInstallSync = lockSafe 3 1 base_1 synced chainInstallSync

lockSafeInstallSyncProof : Path Bool lockSafeInstallSync true
lockSafeInstallSyncProof = refl

chainDropSync : Chain 3 1 synced unsynced
chainDropSync = snoc 3 1 synced synced unsynced (nil 3 1 synced) (dropSync 3 1 synced usersTbl users_name users_display_name refl)

