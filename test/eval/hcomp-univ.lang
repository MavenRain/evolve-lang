-- An hcomp at Type 0 is a Glue type (hcomp_univ): hcompUGlue is refl. The
-- transpEquiv defs use much memory: the hcomp-glue.lang defs are in a
-- different file, and this check does not fit the test/cubical.c arena.
hcompU : (j : I) → Type 0
hcompU j = hcomp (λ l → [ j ↦ ℕ ]) ℕ

hcompUGlue : (j : I) → Path (Type 0) (hcompU j) (Glue ℕ [ j ↦ pack ℕ (transpEquiv (λ i → ℕ)) ])
hcompUGlue j = refl

hcompUAt1 : Type 0
hcompUAt1 = hcompU i1
